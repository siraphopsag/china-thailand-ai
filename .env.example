# Public values (safe in the browser — what each person may read is enforced by row level security in Supabase).
# Set them in Vercel → Project → Settings → Environment Variables (Production and Preview), then redeploy.
# Without them the site works as before, just without "Log in".
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Never put a Supabase service_role key or any other secret in a VITE_ variable: those end up in the browser.
